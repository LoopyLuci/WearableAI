"""
TinyML Pipeline - Host-side tools for training, converting, and deploying models
to the RP2040 wearable assistant.
"""
import logging
import os
import sys
import asyncio
from pathlib import Path
from typing import Dict, Any, Optional
from dataclasses import dataclass, asdict

logger = logging.getLogger("tinyml")

PROJECT_ROOT = Path(__file__).parent.parent.parent
MODELS_DIR = PROJECT_ROOT / "arp-2040" / "models"
HOST_TOOLS = PROJECT_ROOT / "arduino-dashboard" / "host-tools"

@dataclass
class ModelSpec:
    """Specification for a TinyML model"""
    name: str
    architecture: str  # cnn, dnn, 1dcnn
    input_shape: tuple  # e.g., (40, 98, 1) for mel spectrogram
    output_classes: int
    quantized: bool = True
    int8: bool = True

class TinyMLPipeline:
    """Host-side TinyML pipeline for RP2040 deployment"""
    
    def __init__(self):
        self.models: Dict[str, ModelSpec] = {
            "kws_cnn": ModelSpec(
                name="kws_cnn",
                architecture="cnn",
                input_shape=(40, 98, 1),
                output_classes=12,  # 10 keywords + silence + unknown
            ),
            "imu_1dcnn": ModelSpec(
                name="imu_1dcnn",
                architecture="1dcnn",
                input_shape=(6, 50),  # accel+gyro, 50 timesteps
                output_classes=8,  # gesture classes
            ),
            "audio_scene": ModelSpec(
                name="audio_scene",
                architecture="cnn",
                input_shape=(40, 98, 1),
                output_classes=5,  # home, street, office, nature, transport
            ),
        }
    
    async def generate_dummy_model(self, model_name: str) -> Dict[str, Any]:
        """Generate a dummy quantized TFLite model for testing"""
        if model_name not in self.models:
            return {"ok": False, "error": f"Unknown model: {model_name}"}
        
        spec = self.models[model_name]
        output_path = MODELS_DIR / f"{model_name}_dummy.tflite"
        
        # Create a minimal valid TFLite file
        # This is a placeholder - real implementation would use proper TFLite builder
        tflite_magic = b'TFL3'
        dummy_content = tflite_magic + b'\x00' * 100
        
        output_path.parent.mkdir(parents=True, exist_ok=True)
        with open(output_path, 'wb') as f:
            f.write(dummy_content)
        
        logger.info(f"Generated dummy model: {output_path}")
        return {
            "ok": True,
            "model": model_name,
            "path": str(output_path),
            "spec": asdict(spec),
        }
    
    async def validate_model(self, model_path: str) -> Dict[str, Any]:
        """Validate a TFLite model file"""
        path = Path(model_path)
        if not path.exists():
            return {"ok": False, "error": f"File not found: {model_path}"}
        
        # Check magic bytes
        with open(path, 'rb') as f:
            header = f.read(4)
        
        if header == b'TFL3':
            return {
                "ok": True,
                "format": "TFLite FlatBuffer",
                "path": str(path),
                "size_bytes": path.stat().st_size,
            }
        else:
            return {
                "ok": False,
                "error": f"Invalid TFLite magic: {header.hex()}",
                "path": str(path),
            }
    
    async def package_model(self, model_path: str, output_name: Optional[str] = None) -> Dict[str, Any]:
        """Package a model as .armodel for device deployment"""
        src = Path(model_path)
        if not src.exists():
            return {"ok": False, "error": f"Source not found: {model_path}"}
        
        output_name = output_name or src.stem
        output_path = MODELS_DIR / f"{output_name}.armodel"
        
        # Package as signed archive
        import hashlib
        content = src.read_bytes()
        checksum = hashlib.sha256(content).hexdigest()[:16]
        
        # Minimal package format: "ARMD" magic + version + checksum + content
        package = b'ARMD'  # magic
        package += b'\x01\x00\x00\x00'  # version 1
        package += checksum.encode('ascii').ljust(16, b'\x00')
        package += content
        
        output_path.parent.mkdir(parents=True, exist_ok=True)
        with open(output_path, 'wb') as f:
            f.write(package)
        
        logger.info(f"Packaged model: {output_path}")
        return {
            "ok": True,
            "input": str(src),
            "output": str(output_path),
            "size_bytes": output_path.stat().st_size,
            "checksum": checksum,
        }
    
    async def get_model_status(self) -> Dict[str, Any]:
        """Get status of all models"""
        models = {}
        if MODELS_DIR.exists():
            for path in MODELS_DIR.glob("*.armodel"):
                models[path.stem] = {
                    "path": str(path),
                    "size_bytes": path.stat().st_size,
                }
        return {
            "models_dir": str(MODELS_DIR),
            "models": models,
            "count": len(models),
        }

# Singleton
pipeline = TinyMLPipeline()

async def generate_dummy_model(model_name: str) -> Dict[str, Any]:
    return await pipeline.generate_dummy_model(model_name)

async def validate_model(model_path: str) -> Dict[str, Any]:
    return await pipeline.validate_model(model_path)

async def package_model(model_path: str, output_name: Optional[str] = None) -> Dict[str, Any]:
    return await pipeline.package_model(model_path, output_name)

async def get_model_status() -> Dict[str, Any]:
    return await pipeline.get_model_status()
